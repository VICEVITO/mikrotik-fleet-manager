# NetBox
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=your_netbox_token_here
NETBOX_MANUFACTURER=mikrotik
NETBOX_SSL_VERIFY=true

# MikroTik API
MIKROTIK_API_USER=admin
MIKROTIK_API_PASSWORD=your_password_here
MIKROTIK_API_PORT=443
MIKROTIK_USE_HTTPS=true
MIKROTIK_SSL_VERIFY=false
MIKROTIK_TIMEOUT_SECONDS=5.0
